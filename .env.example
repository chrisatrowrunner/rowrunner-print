# RowRunner label print worker — copy to .env and fill in. .env is gitignored.

# ── Supabase (shared orders table) ──────────────────────────────────────────
# PUBLIC anon key only — same key the fan/runner/KDS apps ship. Reads are public;
# the mark_printed / mark_unprinted RPCs are security-definer. NEVER put the
# service_role key on the venue PC.
SUPABASE_URL=https://kboevpucqjoftgmhrkzq.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...replace-with-the-public-anon-key...

# ── Printer (Brother QL-820NWB) ─────────────────────────────────────────────
PRINTER_MODEL=QL-820NWB
PRINTER_BACKEND=network                        # or: pyusb
PRINTER_IDENTIFIER=tcp://192.168.1.50:9100     # printer IP (network); or a usb:// id from `brother_ql discover`

# ── Label ───────────────────────────────────────────────────────────────────
LABEL_SIZE=62                                  # 62mm continuous (DK-2251/DK-22205); or 29x90 die-cut
LABEL_RED=1                                    # print ⚠ note in red (needs a black/red roll)
LABEL_LOGO=1                                   # show the RowRunner logo at the top of the label

# Optional: force a specific TrueType font (absolute path). Blank = auto-detect.
# FONT_BOLD=C:\Windows\Fonts\arialbd.ttf
# FONT_REGULAR=C:\Windows\Fonts\arial.ttf

# ── Behaviour ───────────────────────────────────────────────────────────────
DRY_RUN=1                                      # 1 = render PNG to out/ only, no hardware
POLL_SECONDS=4
# MAX_PRINT_STAGE=3                            # don't print orders already delivered (stage 4)
